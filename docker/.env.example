# Copy to .env and adjust as needed. Do not commit the real .env.
TZ=Pacific/Auckland

# Caddy site addresses. Set these to the hostname and/or IP clients use to
# reach the server. Empty values are ignored (Caddy falls back to a catch-all).
SERVER_HOSTNAME=orangepi3b.local
SERVER_IP=192.168.68.58

# UID/GID that owns the Jellyfin config, cache, and media directories on the
# host. Must match the owner of /mnt/ssd/jellyfin and /mnt/ssd/media.
PUID=1000
PGID=1000
