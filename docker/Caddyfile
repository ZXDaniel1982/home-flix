http://{$SERVER_HOSTNAME}, http://{$SERVER_IP} {
	handle /api/* {
		reverse_proxy jellyfin:8096
	}

	# SvelteKit/Vite content-hash all files under /_app/immutable, so they can be
	# cached forever. Everything else (index.html and the SPA fallback) must
	# revalidate, otherwise a browser can keep serving a stale index.html after a
	# deploy and miss new hashed assets.
	handle /_app/immutable/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Android release artifacts. Served from the same mount as the web app but
	# explicitly routed so the SPA fallback never rewrites them to index.html.
	# The manifest revalidates so a new release is seen immediately; versioned
	# APK filenames are immutable.
	handle /updates/* {
		root * /srv
		header /updates/android/manifest.json Cache-Control "no-cache"
		header /updates/android/*.apk Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
